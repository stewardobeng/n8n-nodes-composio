{
	"name": "@steprotech/n8n-nodes-composio",
	"version": "0.1.1",
	"description": "n8n node for Composio: connect your own apps, choose an action, and run it in any workflow, with or without an AI Agent.",
	"keywords": [
		"n8n-community-node-package",
		"composio",
		"ai-agents",
		"integrations",
		"mcp",
		"oauth",
		"tools",
		"automation"
	],
	"license": "MIT",
	"homepage": "https://gitlab.com/steprotech/n8n-nodes-composio",
	"author": {
		"name": "Steward Obeng",
		"email": "stewardobeng@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/steprotech/n8n-nodes-composio.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.mjs",
		"prepublishOnly": "npm run build && npm run lint && npm test"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ComposioApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Composio/Composio.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
